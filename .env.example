# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# Local dev (docker compose up -d db):
DATABASE_URL="mysql://segundo_cerebro:segundo_cerebro@localhost:53306/segundo_cerebro"
# Hostinger shared hosting: use the MySQL Unix socket, not TCP (see docs/DEPLOYMENT.md).
# DATABASE_URL="mysql://user:password@localhost/database?socket=/var/lib/mysql/mysql.sock"

# --- Auth (Auth.js) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app, used for callback URLs.
AUTH_URL="http://localhost:3000"
# Required in production behind a proxy (Hostinger, Cloudflare, etc.) — without
# it every request fails with [auth][error] UntrustedHost. Set it via this env
# var, NOT `trustHost: true` in lib/auth.ts (that broke in a different way in
# production, see docs/DECISIONS.md).
AUTH_TRUST_HOST="true"

# --- Bootstrap admin user -------------------------------------------------
# Used by `npm run db:seed` to create/update the first admin user.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# --- AI provider (Gemini) --------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --- GitHub integration -----------------------------------------------------
# Fine-grained personal access token, read-only, scoped to the specific repos
# you want to sync (Contents: Read-only, Metadata: Read-only). Never commit it.
GITHUB_TOKEN=""
# Optional: shared secret used to verify GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=""

# --- Cloudflare R2 (object storage: attachments, temp audio) ----------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="segundo-cerebro"
R2_PUBLIC_URL=""

# --- Apple Shortcuts / personal API tokens ----------------------------------
# Tokens themselves are generated and hashed via the app (see SHORTCUTS_FUTURE.md).
# No static shared secret is required here.
